# Bodi.az mühit dəyişənləri — bu faylı .env adı ilə kopyalayın və dəyərləri doldurun.
POSTGRES_DB=bodi
POSTGRES_USER=bodi
POSTGRES_PASSWORD=uzun-tesadufi-sifre

# Root admin yalnız ilk işə salınmada (users cədvəli boş olanda) yaradılır.
ADMIN_ROOT_USERNAME=root
ADMIN_ROOT_PASSWORD=

# Canonical URL-lər, sitemap və schema.org üçün saytın ictimai ünvanı
SITE_URL=https://bodi.az
PUBLIC_PORT=7777
# HTTPS arxasında işləyəndə true edin (admin sessiya cookie-si yalnız HTTPS ilə göndərilir)
COOKIE_SECURE=false
